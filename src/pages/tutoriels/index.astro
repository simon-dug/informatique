---
import Base from "../../layouts/Base.astro";
import CarteTutoriel from "../../components/CarteTutoriel.astro";
import { tousLesTutoriels, sujetsUtilises } from "../../lib/contenu";

const tutoriels = await tousLesTutoriels();
const sujets = sujetsUtilises(tutoriels);
---

<Base
  titre="Tutoriels"
  intro="Les procédures expliquées pas à pas. Chaque tutoriel est indépendant du calendrier : on peut y revenir n'importe quand, autant de fois qu'on veut."
  description="Tutoriels d'informatique : suite Google, cybersécurité, création numérique, fiabilité de l'information et plus."
>
  <div class="section page">
    <form class="filtres sans-impression" role="search" id="filtres">
      <div class="filtres__recherche">
        <label for="recherche">Rechercher un tutoriel</label>
        <div class="champ">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="champ__ico">
            <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2" />
            <line x1="16" y1="16" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <input
            type="search"
            id="recherche"
            name="recherche"
            placeholder="Ex. : signature, mot de passe, Drive…"
            autocomplete="off"
          />
        </div>
      </div>

      {
        sujets.length > 1 && (
          <fieldset class="filtres__sujets">
            <legend>Filtrer par sujet</legend>
            <div class="puces">
              <button type="button" class="puce puce--active" data-sujet="tous">
                Tous
              </button>
              {sujets.map((s) => (
                <button type="button" class="puce" data-sujet={s}>
                  {s}
                </button>
              ))}
            </div>
          </fieldset>
        )
      }
    </form>

    <p class="compte petit" id="compte" role="status" aria-live="polite">
      {tutoriels.length} tutoriel{tutoriels.length > 1 ? "s" : ""}
    </p>

    <ul class="grille" id="liste-tutoriels">
      {tutoriels.map((t) => <CarteTutoriel tutoriel={t} />)}
    </ul>

    <p class="aucun" id="aucun" hidden>
      Aucun tutoriel ne correspond à cette recherche. Essaie un mot plus court,
      ou reviens à <button type="button" class="lien-bouton" id="reinitialiser">tous les tutoriels</button>.
    </p>
  </div>
</Base>

<style>
  .filtres {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    background: var(--fond-doux);
    border: 1px solid var(--bordure);
    border-radius: var(--rayon);
  }

  .filtres label,
  .filtres legend {
    display: block;
    margin-bottom: 0.5rem;
    padding: 0;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texte-doux);
  }
  .filtres fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .champ {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0.9rem;
    background: var(--fond);
    border: 1px solid var(--bordure-forte);
    border-radius: var(--rayon-petit);
  }
  .champ:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-doux);
  }
  .champ__ico {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    color: var(--texte-doux);
  }
  .champ input {
    flex: 1;
    padding: 0.75rem 0;
    border: 0;
    background: none;
    color: var(--texte);
    font: inherit;
    font-size: 1rem;
  }
  .champ input:focus {
    outline: none;
  }

  .puces {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .puce {
    padding: 0.45em 0.95em;
    border: 1px solid var(--bordure-forte);
    border-radius: 999px;
    background: var(--fond);
    color: var(--texte-doux);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease,
      border-color 0.15s ease;
  }
  .puce:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .puce--active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 600;
  }
  :root[data-theme="sombre"] .puce--active {
    color: var(--nuit-950);
  }

  .compte {
    margin-bottom: 1.25rem;
  }

  .aucun {
    padding: 2rem;
    text-align: center;
    color: var(--texte-doux);
    background: var(--fond-doux);
    border: 1px dashed var(--bordure-forte);
    border-radius: var(--rayon);
  }
  .lien-bouton {
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    color: var(--accent);
    text-decoration: underline;
    cursor: pointer;
  }
</style>

<script>
  // Recherche et filtres. Tout se passe dans le navigateur : le site
  // reste un ensemble de fichiers statiques, sans serveur ni base de données.
  const champ = document.getElementById("recherche") as HTMLInputElement | null;
  const puces = Array.from(document.querySelectorAll<HTMLButtonElement>(".puce"));
  const cartes = Array.from(
    document.querySelectorAll<HTMLLIElement>("#liste-tutoriels > li")
  );
  const compte = document.getElementById("compte");
  const aucun = document.getElementById("aucun");
  const reinitialiser = document.getElementById("reinitialiser");

  let sujetChoisi = "tous";

  /** Retire les accents pour que « fiabilite » trouve « fiabilité ». */
  function sansAccents(t: string) {
    return t
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim();
  }

  function appliquer() {
    const termes = sansAccents(champ?.value ?? "").split(/\s+/).filter(Boolean);
    let visibles = 0;

    for (const carte of cartes) {
      const sujetOk =
        sujetChoisi === "tous" || carte.dataset.sujet === sujetChoisi;
      const texte = carte.dataset.recherche ?? "";
      const rechercheOk = termes.every((t) => texte.includes(t));
      const montrer = sujetOk && rechercheOk;
      carte.hidden = !montrer;
      if (montrer) visibles++;
    }

    if (compte) {
      compte.textContent =
        visibles === cartes.length
          ? `${visibles} tutoriel${visibles > 1 ? "s" : ""}`
          : `${visibles} tutoriel${visibles > 1 ? "s" : ""} sur ${cartes.length}`;
    }
    if (aucun) aucun.hidden = visibles > 0;
  }

  champ?.addEventListener("input", appliquer);

  for (const puce of puces) {
    puce.addEventListener("click", () => {
      sujetChoisi = puce.dataset.sujet ?? "tous";
      for (const p of puces) p.classList.toggle("puce--active", p === puce);
      appliquer();
    });
  }

  reinitialiser?.addEventListener("click", () => {
    if (champ) champ.value = "";
    sujetChoisi = "tous";
    for (const p of puces) {
      p.classList.toggle("puce--active", p.dataset.sujet === "tous");
    }
    appliquer();
    champ?.focus();
  });

  // Le formulaire ne doit jamais être soumis : tout est instantané.
  document.getElementById("filtres")?.addEventListener("submit", (e) => {
    e.preventDefault();
  });
</script>
