---
import Base from "../layouts/Base.astro";
import CarteSemaine from "../components/CarteSemaine.astro";
import CarteTutoriel from "../components/CarteTutoriel.astro";
import { site } from "../site.config";
import { lien } from "../lib/url";
import { toutesLesSemaines, tousLesTutoriels } from "../lib/contenu";

const semaines = await toutesLesSemaines();
const tutoriels = await tousLesTutoriels();

// Les trois semaines les plus avancées dans l'année : ce que la classe
// vient de voir ou s'apprête à voir.
const dernieresSemaines = [...semaines].reverse().slice(0, 3);
const derniersTutoriels = [...tutoriels]
  .sort((a, b) => b.data.maj.getTime() - a.data.maj.getTime())
  .slice(0, 3);

// Les deux grandes portes : ce que les élèves viennent chercher en
// premier. Elles gardent leur descriptif et leur ligne d'action.
const portes = [
  {
    titre: "Contenu des cours",
    lien: "/contenu-des-cours",
    texte: "Objectifs et déroulement de chaque cours.",
    action: "Voir les semaines",
  },
  {
    titre: "Tutoriels",
    lien: "/tutoriels",
    texte:
      "Des guides pour apprendre à mieux utiliser les différents outils numériques.",
    action: "Parcourir les tutoriels",
  },
];

// Les liens secondaires : plus petits, sans descriptif. Ils mènent aux
// pages d'information, qu'on cherche par leur nom et non par leur
// description.
const liensRapides = [
  { titre: "À propos", lien: "/a-propos" },
  { titre: "Me contacter", lien: "/me-contacter" },
  { titre: "Pour les enseignants", lien: "/pour-les-enseignants" },
];
---

<Base
  titre={site.nom}
  variante="haute"
  intro="Voici le site du cours d'informatique. Vous pourrez y retrouver le contenu de chaque cours, des tutoriels pour mieux utiliser le numérique et des informations utiles. Élèves, enseignants et curieux : tout est disponible ici, en accès libre !"
>
  <section class="section page">
    <ul class="grille portes">
      {
        portes.map((p) => (
          <li>
            <a class="carte porte" href={lien(p.lien)}>
              <h3>{p.titre}</h3>
              <p>{p.texte}</p>
              <p class="porte__action">{p.action} →</p>
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="liens-rapides">
      {
        liensRapides.map((l) => (
          <li>
            <a class="lien-rapide" href={lien(l.lien)}>
              {l.titre}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    dernieresSemaines.length > 0 && (
      <section class="bande">
        <div class="section page">
          <div class="section__entete">
            <h2>Les dernières semaines</h2>
            <a href={lien("/contenu-des-cours")}>Tout le contenu des cours →</a>
          </div>
          <ul class="grille">
            {dernieresSemaines.map((s) => (
              <CarteSemaine semaine={s} nbTutoriels={s.data.tutoriels.length} />
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    derniersTutoriels.length > 0 && (
      <section class="section page">
        <div class="section__entete">
          <h2>Tutoriels récemment mis à jour</h2>
          <a href={lien("/tutoriels")}>Tous les tutoriels →</a>
        </div>
        <ul class="grille">
          {derniersTutoriels.map((t) => (
            <CarteTutoriel tutoriel={t} />
          ))}
        </ul>
      </section>
    )
  }

  <section class="section page">
    <div class="appel">
      <div class="contenu">
        <h2>Enseignant ou enseignante ?</h2>
        <p>
          Ce site est public volontairement. Les tutoriels sont écrits pour
          pouvoir être repris tels quels dans une autre classe, une autre école
          ou un autre contexte. Prenez ce qui vous est utile, adaptez le reste.
        </p>
        <p>
          <a class="bouton" href={lien("/pour-les-enseignants")}>
            Pour les enseignants
          </a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Deux grandes portes d'entrée, côte à côte, bien lisibles au
     projecteur. Sous 46rem, elles passent l'une sous l'autre. */
  .portes {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 46rem) {
    .portes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .porte h3 {
    font-size: 1.35rem;
  }
  .porte__action {
    margin-top: auto;
    padding-top: 0.6rem;
    font-weight: 600;
    color: var(--accent);
    font-size: 0.95rem;
  }

  /* Rangée des liens secondaires : des boutons, pas des cartes. Ils
     se partagent la largeur et se replient sur plusieurs lignes quand
     l'écran rétrécit. */
  .liens-rapides {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .liens-rapides li {
    flex: 1 1 12rem;
    margin: 0;
  }
  .lien-rapide {
    display: block;
    padding: 0.85rem 1.1rem;
    text-align: center;
    background: var(--fond-carte);
    border: 1px solid var(--bordure);
    border-radius: var(--rayon-petit);
    box-shadow: var(--ombre);
    color: var(--texte);
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease,
      color 0.15s ease, box-shadow 0.15s ease;
  }
  .lien-rapide:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    color: var(--accent-fort);
    box-shadow: var(--ombre-forte);
  }

  .bande {
    background: var(--fond-doux);
    border-top: 1px solid var(--bordure);
    border-bottom: 1px solid var(--bordure);
  }

  .appel {
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border: 1px solid var(--bordure);
    border-left: 5px solid var(--accent);
    border-radius: var(--rayon);
    background: var(--fond-carte);
    box-shadow: var(--ombre);
  }
  .appel h2 {
    margin-top: 0;
    border: 0;
    padding: 0;
  }
  .appel p:last-child {
    margin-bottom: 0;
  }
</style>
