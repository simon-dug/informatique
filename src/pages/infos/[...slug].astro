---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import FilAriane from "../../components/FilAriane.astro";
import BarreOutils from "../../components/BarreOutils.astro";
import { lien } from "../../lib/url";
import { toutesLesInfos } from "../../lib/contenu";

export async function getStaticPaths() {
  const pages = await toutesLesInfos();
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Base
  titre={page.data.titre}
  surtitre="Informations générales"
  intro={page.data.description}
  description={page.data.description}
>
  <div class="section page">
    <FilAriane
      chemin={[
        { titre: "Informations", lien: lien("/infos") },
        { titre: page.data.titre },
      ]}
    />
    <BarreOutils />
    <article class="contenu">
      <Content />
    </article>
  </div>
</Base>
